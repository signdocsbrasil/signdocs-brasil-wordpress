includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
parameters:
    level: 5
    # WordPress core return types are often specified more restrictively
    # in phpstan-wordpress than reality (e.g. wp_insert_post is int|WP_Error
    # but typed as int<1, max>). Treating PHPDoc types as uncertain lets
    # defensive runtime guards coexist with the stubs.
    treatPhpDocTypesAsCertain: false
    paths:
        - src
    excludePaths:
        - src/Cli/*
    bootstrapFiles:
        - vendor/autoload.php
    # The plugin's own constants are define()d in the root bootstrap file,
    # which is not in `paths` because it is not worth analysing. Scanning it
    # lets phpstan discover SIGNDOCS_VERSION / SIGNDOCS_PLUGIN_URL without
    # having to ignore every use of them.
    scanFiles:
        - signdocs-brasil.php
    ignoreErrors:
        # SIGNDOCS_PLUGIN_URL is define()d as plugin_dir_url(__FILE__), which
        # phpstan cannot evaluate while scanning, so the constant never gets
        # registered even though the file is in scanFiles. SIGNDOCS_VERSION,
        # a literal, resolves fine. Scoped to the constant rather than blanket
        # "Constant .* not found" so a genuine typo still fails.
        -
            message: '#Constant SIGNDOCS_PLUGIN_URL not found\.#'
            path: src/*
